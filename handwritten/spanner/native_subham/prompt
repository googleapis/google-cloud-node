      const sessionName = await this._getSessionName();
      const token = await this._getFreshToken();
      return await spannerNative.executeSqlNative(
          sessionName, sql, token, channelCount
      );
  }

The call signature stays the same — napi-rs handles the callback
to Promise wrapping automatically. No change needed to poc_bridge.js
unless the existing call throws a type error about missing callback
argument. If it does, change to:

  async executeSqlNative(sql, channelCount = 1) {
      const sessionName = await this._getSessionName();
      const token = await this._getFreshToken();
      return new Promise((resolve, reject) => {
          spannerNative.executeSqlNative(
              sessionName,
              sql,
              token,
              channelCount,
              (err, result) => {
                  if (err) reject(err);
                  else resolve(result);
              }
          );
      });
  }

