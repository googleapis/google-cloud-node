2. New execute_sql_native function:

   #[napi]
   pub fn execute_sql_native(
       env: Env,
       session_name: String,
       sql: String,
       token: String,
       channel_count: i32,
       callback: JsFunction,
   ) -> napi::Result<()> {

       // Create a ThreadsafeFunction from the JS callback.
       // This is a handle that can be called safely from any thread
       // including Tokio worker threads which have no access to V8.
       // The closure provided here runs ON THE V8 THREAD when called back.
       // It receives the Vec<Vec<String>> result from Rust and converts
       // it to a JavaScript Array to resolve the Promise.
       let tsfn: ThreadsafeFunction
           Vec<Vec<String>>,
           ErrorStrategy::CalleeHandled
       > = callback.create_threadsafe_function(
           0,
           |ctx: napi::threadsafe_function::ThreadSafeCallContext<Vec<Vec<String>>>| {
               // This closure runs on V8 thread — safe to create JS objects
               let rows = ctx.value;
               let mut outer = ctx.env.create_array_with_length(rows.len())?;
               for (i, row) in rows.into_iter().enumerate() {
                   let mut inner = ctx.env
                       .create_array_with_length(row.len())?;
                   for (j, cell) in row.into_iter().enumerate() {
                       let js_str = ctx.env.create_string(&cell)?;
                       inner.set_element(j as u32, js_str)?;
                   }
                   outer.set_element(i as u32, inner)?;
               }
               Ok(vec![outer.into_unknown()])
           }
       )?;

       // Clone values needed inside the async task.
       // Cannot move String references across the spawn boundary
       // without cloning because the async task may outlive this
       // function call on the V8 thread.
       let session_clone  = session_name.clone();
       let sql_clone      = sql.clone();
       let token_clone    = token.clone();

       // Spawn DIRECTLY onto the static Tokio runtime.
       // This returns immediately — V8 thread is free.
       // libuv thread pool is NOT involved at all.
       // Tokio manages this async task on its own worker threads.
       RUNTIME.spawn(async move {
           // Channel selection — same round-robin logic as before
           let count = channel_count.max(1) as usize;
           let idx = REQUEST_COUNTER.fetch_add(1, Ordering::Relaxed)
               % count.min(CHANNELS.len());
           let channel = CHANNELS[idx].clone();

           // Build interceptor and client — same as before
           let interceptor = AuthInterceptor {
               token: token_clone,
               session_name: session_clone.clone(),
           };
           let mut client = SpannerClient::with_interceptor(
               channel,
               interceptor
           );

           // Build request — same as before
           let request = ExecuteSqlRequest {
               session: session_clone,
               sql: sql_clone,
               ..Default::default()
           };

           // Execute gRPC call — Tokio awaits, no thread blocked
           let result = client.execute_sql(request).await;

           // Call back into V8 with result via ThreadsafeFunction
           // NonBlocking means Tokio does not wait for V8 to process
           // the callback before continuing
           match result {
               Ok(response) => {
                   let rows = decode_result_set(response.into_inner());
                   tsfn.call(
                       Ok(rows),
                       ThreadSafeFunctionCallMode::NonBlocking
                   );
               }
               Err(status) => {
                   tsfn.call(
                       Err(napi::Error::from_reason(format!(
                           "gRPC execute_sql failed: ({:?}) {}",
                           status.code(),
                           status.message()
                       ))),
                       ThreadSafeFunctionCallMode::NonBlocking
                   );
               }
           }
       });

       // Return Ok(()) immediately.
       // The Promise is handled by napi-rs via the ThreadsafeFunction.
       // V8 thread is free from this point.
       Ok(())
   }

