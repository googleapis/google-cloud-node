FROM node:22-bookworm-slim
ENV NODE_ENV=production
WORKDIR /app
ARG SPANNER_VERSION=8.7.1
RUN npm init -y \
 && npm install --omit=dev "@google-cloud/spanner@${SPANNER_VERSION}" @grpc/grpc-js@1.14.3 tsx \
 && npm cache clean --force
COPY --chown=node:node --chmod=0444 issue/node/benchmark-read-repl.ts ./benchmark-read-repl.mts
USER node
ENTRYPOINT ["/app/node_modules/.bin/tsx", "/app/benchmark-read-repl.mts"]
