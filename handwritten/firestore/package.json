{
  "name": "@google-cloud/firestore",
  "description": "Firestore Client Library for Node.js",
  "version": "9.3.0",
  "license": "Apache-2.0",
  "author": "Google Inc.",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "directory": "handwritten/firestore",
    "url": "https://github.com/googleapis/google-cloud-node.git"
  },
  "main": "./build/src/index.js",
  "types": "./types/firestore.d.ts",
  "files": [
    "build/protos",
    "build/src",
    "!build/src/**/*.map",
    "types",
    "pipelines"
  ],
  "keywords": [
    "google apis client",
    "google api client",
    "google apis",
    "google api",
    "google",
    "google cloud platform",
    "google cloud",
    "cloud",
    "firestore"
  ],
  "scripts": {
    "precloud-rad": "pnpm run compile",
    "cloud-rad": "NO_UPLOAD=1 npx @google-cloud/cloud-rad",
    "preapi-report": "pnpm run compile",
    "api-report": "node scripts/api-report.mjs",
    "predocs": "pnpm run compile",
    "docs": "jsdoc -c .jsdoc.js",
    "system-test:rest": "FIRESTORE_DATABASE_ID=firestore-standard FIRESTORE_PREFER_REST=true vitest run dev/system-test --testTimeout=1200000",
    "system-test:enterprise:rest": "RUN_ENTERPRISE_TESTS=yes FIRESTORE_DATABASE_ID=firestore-enterprise FIRESTORE_PREFER_REST=true vitest run dev/system-test --testTimeout=1200000",
    "system-test:grpc": "FIRESTORE_DATABASE_ID=firestore-standard vitest run dev/system-test --testTimeout=1200000",
    "system-test:enterprise:grpc": "RUN_ENTERPRISE_TESTS=yes FIRESTORE_DATABASE_ID=firestore-enterprise vitest run dev/system-test --testTimeout=1200000",
    "system-test:emulator:rest": "FIRESTORE_EMULATOR_HOST=localhost:8080 FIRESTORE_PREFER_REST=true vitest run dev/system-test --testTimeout=1200000",
    "system-test:enterprise:emulator:rest": "RUN_ENTERPRISE_TESTS=yes FIRESTORE_DATABASE_ID=firestore-enterprise FIRESTORE_EMULATOR_HOST=localhost:8080 FIRESTORE_PREFER_REST=true vitest run dev/system-test --testTimeout=1200000",
    "system-test:emulator:grpc": "FIRESTORE_EMULATOR_HOST=localhost:8080 vitest run dev/system-test --testTimeout=1200000",
    "system-test:enterprise:emulator:grpc": "RUN_ENTERPRISE_TESTS=yes FIRESTORE_DATABASE_ID=firestore-enterprise FIRESTORE_EMULATOR_HOST=localhost:8080 vitest run dev/system-test --testTimeout=1200000",
    "system-test": "concurrently -p \"[{name}]\" -n \"grpc,rest,enterprise-grpc,enterprise-rest\" -c \"cyan,magenta,blue,yellow\" \"pnpm:system-test:grpc\" \"pnpm:system-test:rest\" \"pnpm:system-test:enterprise:grpc\" \"pnpm:system-test:enterprise:rest\"",
    "system-test:nightly": "FIRESTORE_TARGET_BACKEND=nightly FIRESTORE_DATABASE_ID=enterprise RUN_ENTERPRISE_TESTS=yes GCLOUD_PROJECT=firestore-sdk-nightly vitest run dev/system-test --testTimeout=1200000",
    "system-test:emulator": "concurrently -p \"[{name}]\" -n \"grpc,rest,enterprise-grpc,enterprise-rest\" -c \"cyan,magenta,blue,yellow\" \"pnpm:system-test:emulator:grpc\" \"pnpm:system-test:emulator:rest\" \"pnpm:system-test:enterprise:emulator:grpc\" \"pnpm:system-test:enterprise:emulator:rest\"",
    "presystem-test": "pnpm run compile",
    "conformance": "vitest run dev/conformance",
    "test-only": "vitest run dev/test --coverage",
    "pretest": "pnpm run compile",
    "test": "pnpm run test-only && pnpm run conformance",
    "lint": "gts check",
    "clean": "gts clean",
    "compile": "tsc -p .",
    "postcompile": "node scripts/init-directories.js && cp -r dev/protos build && cp dev/protos/*.d.ts build/types/protos && cp dev/conformance/test-definition.proto build/conformance && cp dev/conformance/conformance-tests/*.json build/conformance/conformance-tests && minifyProtoJson",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "precompile": "gts clean"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "fast-deep-equal": "^3.1.3",
    "functional-red-black-tree": "^1.0.1",
    "google-gax": "^6.0.1",
    "protobufjs": "^7.5.3",
    "@google-cloud/firestore-api": "^0.2.0"
  },
  "devDependencies": {
    "@google-cloud/cloud-rad": "^0.4.10",
    "@google-cloud/opentelemetry-cloud-trace-exporter": "^3.0.0",
    "@google-cloud/promisify": "^6.0.1",
    "@google-cloud/trace-agent": "^8.0.0",
    "@googleapis/cloudtrace": "^3.0.1",
    "@js-temporal/polyfill": "^0.5.1",
    "@opentelemetry/context-async-hooks": "^2.0.1",
    "@opentelemetry/sdk-trace-node": "^2.0.1",
    "@types/assert": "^1.5.11",
    "@types/duplexify": "^3.6.4",
    "@types/extend": "^3.0.4",
    "@types/node": "^24.1.0",
    "@types/through2": "^2.0.41",
    "@vitest/coverage-v8": "4.1.10",
    "codecov": "^3.8.3",
    "concurrently": "^9.1.2",
    "duplexify": "^4.1.3",
    "eslint-plugin-node": "^11.1.0",
    "execa": "^9.6.0",
    "extend": "^3.0.2",
    "fs-extra": "^11.3.0",
    "gapic-tools": "^2.0.1",
    "gts": "^6.0.2",
    "jsdoc": "^4.0.4",
    "jsdoc-fresh": "^6.0.0",
    "jsdoc-region-tag": "^5.0.0",
    "length-prefixed-json-stream": "^1.0.1",
    "long": "^5.3.2",
    "mkdirp": "^3.0.1",
    "path-to-regexp": "^8.2.0",
    "protobufjs-cli": "^1.1.3",
    "through2": "^4.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "5.0.7"
  },
  "exports": {
    ".": {
      "types": "./types/firestore.d.ts",
      "default": "./build/src/index.js"
    },
    "./pipelines": {
      "types": "./types/pipelines.d.ts",
      "default": "./build/src/pipelines/index.js"
    },
    "./package.json": "./package.json",
    "./build/src/path": "./build/src/path.js"
  },
  "homepage": "https://github.com/googleapis/google-cloud-node/tree/main/handwritten/firestore"
}
