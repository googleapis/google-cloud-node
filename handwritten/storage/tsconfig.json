{
    "extends": "./node_modules/gts/tsconfig-google.json",
    "compilerOptions": {
        "rootDir": ".",
        "outDir": "build/esm",
        "resolveJsonModule": true,
        "module": "node16",
        "moduleResolution": "node16",
        "lib": ["ES2020"],
        "sourceMap": false,
        "esModuleInterop": true,
    },
    "include": [
        "src/*.ts",
        "src/**/*.ts",
        "src/*.cjs",
        "test/*.ts",
        "test/**/*.ts",
        "conformance-test/*.ts",
        "conformance-test/**/*.ts",
        "internal-tooling/*.ts",
        "system-test/*.ts",
        "system-test/**/*.ts"
    ]
}