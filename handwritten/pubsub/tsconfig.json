{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "build",
    "resolveJsonModule": true,
    "lib": [
      "es2023",
      "dom"
    ],
    "baseUrl": ".",
    "paths": {
      "@opentelemetry/semantic-conventions/incubating": [
        "./node_modules/@opentelemetry/semantic-conventions/build/src/index-incubating"
      ]
    }
  },
  "include": [
    "src/*.ts",
    "src/**/*.ts",
    "test/*.ts",
    "test/**/*.ts",
    "system-test/*.ts",
    "src/**/*.json",
    "samples/**/*.json",
    "protos/protos.json"
  ]
}
