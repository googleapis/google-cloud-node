{
  "name": "@google-cloud/spanner-driver",
  "version": "0.1.0",
  "description": "Node.js driver for Google Spanner",
  "repository": {
    "type": "git",
    "url": "https://github.com/googleapis/google-cloud-node.git",
    "directory": "handwritten/spanner-driver"
  },
  "license": "Apache-2.0",
  "author": "Google LLC",
  "main": "./build/cjs/src/index.js",
  "module": "./build/esm/src/index.js",
  "types": "./build/cjs/src/index.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./build/esm/src/index.d.ts",
        "default": "./build/esm/src/index.js"
      },
      "require": {
        "types": "./build/cjs/src/index.d.ts",
        "default": "./build/cjs/src/index.js"
      }
    }
  },
  "files": [
    "build/esm/src",
    "build/cjs/src",
    "build/cjs/package.json"
  ],
  "scripts": {
    "clean": "gts clean",
    "compile:esm": "tsc -p .",
    "compile:cjs": "tsc -p ./tsconfig.cjs.json && node -e \"require('fs').writeFileSync('build/cjs/package.json', JSON.stringify({type: 'commonjs'}))\"",
    "compile": "npm run compile:esm && npm run compile:cjs",
    "fix": "gts fix",
    "lint": "gts check",
    "prepare": "npm run compile",
    "test:esm": "c8 mocha build/esm/test/unit/**/*.js",
    "test:cjs": "c8 mocha build/cjs/test/unit/**/*.js",
    "test": "npm run test:esm && npm run test:cjs",
    "system-test": "mocha build/esm/system-test/**/*.js --timeout 60000",
    "test:pg-suite": "node test/pg-suite/run_pg_suite.cjs"
  },
  "dependencies": {
    "@google-cloud/spanner": "^8.7.1"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.13.9",
    "@types/sinon": "^17.0.4",
    "c8": "^10.1.3",
    "gts": "^6.0.2",
    "mocha": "^11.1.0",
    "sinon": "^21.0.3",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": ">=22"
  },
  "optionalDependencies": {
    "@google-cloud/spannerlib-node-darwin-arm64": "^0.1.0",
    "@google-cloud/spannerlib-node-linux-x64": "^0.1.0",
    "@google-cloud/spannerlib-node-linux-arm64": "^0.1.0",
    "@google-cloud/spannerlib-node-win32-x64": "^0.1.0"
  }
}
