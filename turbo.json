{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "compile": {
      "dependsOn": ["^compile"],
      "inputs": [
        "src/**",
        "test/**",
        "system-test/**",
        "protos/**",
        "tsconfig.json"
      ],
      "outputs": ["build/**", "esm/**"]
    }
  }
}
