{
  "name": "proto3-json-serializer",
  "version": "4.0.2",
  "repository": {
    "type": "git",
    "directory": "core/packages/proto3-json-serializer-nodejs",
    "url": "https://github.com/googleapis/google-cloud-node.git"
  },
  "description": "Support for proto3 JSON serialiazation/deserialization for protobuf.js",
  "main": "build/src/index.js",
  "types": "build/src/index.d.ts",
  "files": [
    "build/src"
  ],
  "license": "Apache-2.0",
  "keywords": [
    "protobufjs",
    "protobuf.js",
    "protobuf",
    "proto3",
    "json",
    "serialization",
    "deserialization"
  ],
  "scripts": {
    "test": "c8 mocha build/test/unit",
    "system-test": "mocha build/test/system",
    "lint": "gts lint",
    "clean": "gts clean && rm -f tsconfig.tsbuildinfo",
    "compile": "tsc --build",
    "fix": "gts fix",
    "prepare": "npm run compile",
    "pretest": "npm run compile",
    "compile-test-protos": "cd test-fixtures/proto && pbjs -t json test.proto > test.json",
    "docs": "jsdoc -c .jsdoc.js",
    "samples-test": "cd samples/ && npm link ../ && npm test && cd ../",
    "prelint": "cd samples && npm link ../ && npm install"
  },
  "dependencies": {
    "protobufjs": "^7.5.4"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.0",
    "c8": "^10.1.3",
    "google-proto-files": "^6.0.0",
    "gts": "^6.0.2",
    "jsdoc": "^4.0.4",
    "jsdoc-fresh": "^6.0.0",
    "jsdoc-region-tag": "^5.0.0",
    "mocha": "^11.1.0",
    "pack-n-play": "^5.0.0",
    "protobufjs-cli": "^1.2.0",
    "typescript": "5.8.3"
  },
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://github.com/googleapis/google-cloud-node/tree/main/core/packages/proto3-json-serializer-nodejs"
}
