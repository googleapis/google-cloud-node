{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2018",
    "rootDir": ".",
    "outDir": "build",
    "resolveJsonModule": true,
    "noImplicitAny": true,
    "skipLibCheck": true,
    "strict": true,
    "lib": [
      "es2018",
      "dom"
    ]
  },
  "include": [
    "src/*.ts",
    "src/**/*.ts",
    "test/*.ts",
    "test/**/*.ts"
  ]
}
