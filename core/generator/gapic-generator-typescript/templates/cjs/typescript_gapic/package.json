{
  "name": "{{ api.publishName }}",
  "version": "0.1.0",
  "description": "{{ api.naming.productName }} client for Node.js",
  "repository": {
    "type": "git",
    "directory": "packages/{{ api.naming.namePath }}",
    "url": "https://github.com/googleapis/google-cloud-node.git"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/googleapis/google-cloud-node/tree/main/packages/{{ api.naming.namePath }}",
  "author": "Google LLC",
  "main": "build/src/index.js",
  "files": [
    "build/src",
    "build/protos"
  ],
  "keywords": [
    "google apis client",
    "google api client",
    "google apis",
    "google api",
    "google",
    "google cloud platform",
    "google cloud",
    "cloud",
    "google {{ api.naming.productName.toCamelCase() }}",
    "{{ api.naming.productName.toCamelCase() }}",
    "{{ api.uniqKeywords.join('\",\"') | safe }}"
  ],
  "scripts": {
    "clean": "gts clean",
    "compile": "tsc -p . && cp -r protos build/{% if not api.legacyProtoLoad %} && minifyProtoJson{% endif %}",
    "compile-protos": "compileProtos {% if api.legacyProtoLoad %}--skip-json {% endif %}src",
    "docs": "jsdoc -c .jsdoc.js",
    "fix": "gts fix",
    "lint": "gts check",
    "prepare": "npm run compile-protos && npm run compile",
    "system-test": "c8 mocha --config ../../.mocharc.cjs --no-parallel build/system-test",
    "test": "c8 mocha --config ../../.mocharc.cjs build/test"
  },
  "dependencies": {
    "google-gax": "^6.0.0"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.12",
    "@types/sinon": "^20.0.0",
    "c8": "^10.1.3",
    "gapic-tools": "^1.0.3",
    "gts": "^6.0.2",
    "jsdoc": "^4.0.5",
    "jsdoc-fresh": "^5.0.2",
    "jsdoc-region-tag": "^4.0.1",
    "long": "^5.3.2",
    "mocha": "^11.7.4",
    "pack-n-play": "^4.2.1",
    "typescript": "5.8.3",
    "sinon": "^20.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
