{
  "schema": "1.0",
  "comment": "This file maps proto services/RPCs to the corresponding library clients/methods",
  "language": "typescript",
  "protoPackage": "google.maps.isochrones.v1",
  "libraryPackage": "@google-maps/isochrones",
  "services": {
    "IsochroneService": {
      "clients": {
        "grpc": {
          "libraryClient": "IsochroneServiceClient",
          "rpcs": {
            "GenerateIsochrone": {
              "methods": [
                "generateIsochrone"
              ]
            }
          }
        },
        "grpc-fallback": {
          "libraryClient": "IsochroneServiceClient",
          "rpcs": {
            "GenerateIsochrone": {
              "methods": [
                "generateIsochrone"
              ]
            }
          }
        }
      }
    }
  }
}
