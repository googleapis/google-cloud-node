                "searchDocumentChunksAsync"
              ]
            }
          }
        },
        "grpc-fallback": {
          "libraryClient": "DeveloperKnowledgeClient",
          "rpcs": {
            "GetDocument": {
              "methods": [
                "getDocument"
              ]
            },
            "BatchGetDocuments": {
              "methods": [
                "batchGetDocuments"
              ]
            },
            "SearchDocumentChunks": {
              "methods": [
                "searchDocumentChunks",
                "searchDocumentChunksStream",
                "searchDocumentChunksAsync"
              ]
            }
          }
        }
      }
    }
  }
