{
  "extends": [
    "config:base",
    "docker:disable"
  ],
  "constraintsFiltering": "strict",
  "pinVersions": false,
  "rebaseStalePrs": false,
  "schedule": [
    "every Monday"
  ],
  "prCreation": "not-recreate",
  "gitAuthor": null,
  "packageRules": [
    {
      "extends": "packages:linters",
      "groupName": "linters"
    },
    {
      "matchUpdateTypes": [
        "minor"
      ],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "allowedUpdateTypes": ["major", "patch"]
    }
  ],
  "ignoreDeps": [
    "typescript"
  ]
}
