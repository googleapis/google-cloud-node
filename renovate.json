{
  "extends": [
    "config:best-practices",
    "docker:disable"
  ],
  "constraintsFiltering": "strict",
  "minimumReleaseAge": "21 days",
  "pinVersions": false,
  "rebaseStalePrs": false,
  "schedule": [
    "0 9 * * 1"
  ],
  "gitAuthor": null,
  "packageRules": [
    {
      "extends": "packages:linters",
      "groupName": "linters"
    },
    {
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor"],
      "enabled": false
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["0 9 * * 1"],
    "groupName": "lockfile maintenance"
  },
  "ignoreDeps": [
    "typescript"
  ]
}
